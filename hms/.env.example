# ---- Aduraking HMS environment ----
# Copy to .env for local development. NEVER commit real secrets.

# PostgreSQL connection (docker compose default shown)
DATABASE_URL="postgresql://hms:hms_dev_password@localhost:5432/hms?schema=public"
# Separate database used by integration tests (wiped between runs)
TEST_DATABASE_URL="postgresql://hms:hms_dev_password@localhost:5432/hms_test?schema=public"

# Public base URL (used for reset links and Origin checks)
APP_URL="http://localhost:3000"

# 32-byte base64 key used for AES-256-GCM encryption of MFA secrets and
# sensitive identifiers. Generate with:  openssl rand -base64 32
# Production startup FAILS if this is missing or weak.
DATA_ENCRYPTION_KEY=""

# 32+ byte random secret used to HMAC searchable "blind index" values.
# Generate with: openssl rand -base64 32
BLIND_INDEX_KEY=""

# Require MFA enrolment for roles flagged as privileged (always forced true in production)
MFA_ENFORCE="false"

# Session settings (minutes)
SESSION_IDLE_MINUTES="30"
SESSION_ABSOLUTE_HOURS="12"

# Storage adapter: "local" (dev only, ./storage) or "s3"
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Notification adapters are disabled until credentials and agreements exist.
EMAIL_PROVIDER="disabled"
SMS_PROVIDER="disabled"

# Log level: debug | info | warn | error
LOG_LEVEL="info"

# Online payments stay disabled until the hospital has a merchant agreement.
PAYMENT_PROVIDER=disabled
# PAYMENT_WEBHOOK_SECRET=

# Public demonstration deployment with fictional data only: shows a warning banner everywhere.
# Leave "false" for a real hospital deployment.
HMS_DEMO_SITE="false"
