// Aduraking HMS - Prisma schema
// Conventions:
//  * ids are random UUIDv4 (never sequential, never guessable in URLs)
//  * human-readable references (MRN, encounter ref) come from the Sequence table
//  * money is stored as integer kobo (BigInt/Int) - never floats
//  * timestamps are UTC (timestamptz); display converts to Africa/Lagos
//  * clinical/financial records are never hard-deleted; relations use Restrict

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Organisation & configuration ─────────────────────────

enum VerificationStatus {
  UNKNOWN
  AWAITING_APPROVAL
  VERIFIED
  REJECTED
}

enum BranchStatus {
  ACTIVE
  PENDING_VERIFICATION
  INACTIVE
}

model Organization {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  subtitle   String?
  tagline    String?
  legalName  String?
  website    String?
  email      String?
  phoneE164  String?
  timezone   String   @default("Africa/Lagos")
  currency   String   @default("NGN")
  letterhead String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  version    Int      @default(0)

  branches Branch[]
}

model Branch {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  code               String             @unique
  name               String
  addressLine        String?
  city               String?
  state              String?
  phoneE164          String?
  email              String?
  status             BranchStatus       @default(PENDING_VERIFICATION)
  verificationStatus VerificationStatus @default(UNKNOWN)
  verificationNotes  String?
  isDemo             Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  version            Int                @default(0)

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  departments    Department[]
  wards          Ward[]
  userRoles      UserRole[]
  patients       Patient[]
  appointments   Appointment[]
  encounters     Encounter[]
  orders         ServiceOrder[]
  stockLocations StockLocation[]
  prescriptions  Prescription[]
  requisitions   PurchaseRequisition[]
}

enum DepartmentKind {
  CLINICAL
  DIAGNOSTIC
  SUPPORT
  ADMINISTRATIVE
}

model Department {
  id        String         @id @default(uuid()) @db.Uuid
  branchId  String         @db.Uuid
  code      String
  name      String
  kind      DepartmentKind
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  wards        Ward[]
  visitTypes   VisitType[]
  userRoles    UserRole[]
  appointments Appointment[]
  encounters   Encounter[]

  @@unique([branchId, code])
}

enum WardKind {
  GENERAL
  MATERNITY
  LABOUR
  PAEDIATRIC
  NEWBORN
  EMERGENCY
  PRIVATE
  OTHER
}

model Ward {
  id           String   @id @default(uuid()) @db.Uuid
  branchId     String   @db.Uuid
  departmentId String?  @db.Uuid
  code         String
  name         String
  kind         WardKind
  active       Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  beds       Bed[]

  @@unique([branchId, code])
}

enum BedStatus {
  FREE
  RESERVED
  OCCUPIED
  CLEANING
  UNAVAILABLE
}

model Bed {
  id        String    @id @default(uuid()) @db.Uuid
  wardId    String    @db.Uuid
  code      String
  label     String
  category  String    @default("STANDARD")
  status    BedStatus @default(FREE)
  isDemo    Boolean   @default(false)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  version   Int       @default(0)

  ward Ward @relation(fields: [wardId], references: [id], onDelete: Restrict)

  @@unique([wardId, code])
}

model VisitType {
  id                 String   @id @default(uuid()) @db.Uuid
  departmentId       String?  @db.Uuid
  code               String   @unique
  name               String
  defaultDurationMin Int      @default(15)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  encounters   Encounter[]
}

/// Public facts imported for onboarding. Nothing here is treated as truth until VERIFIED.
model SetupFact {
  id           String             @id @default(uuid()) @db.Uuid
  key          String             @unique
  category     String
  label        String
  value        String
  source       String?
  status       VerificationStatus @default(UNKNOWN)
  notes        String?
  verifiedById String?            @db.Uuid
  verifiedAt   DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  verifiedBy User? @relation("SetupFactVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// Transactional counters for human-readable identifiers (MRN, encounter refs, ...)
model Sequence {
  scope String @id
  value BigInt @default(0)
}

// ───────────────────────── Identity, access & security ─────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserKind {
  STAFF
  PORTAL
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  kind                UserKind   @default(STAFF)
  email               String     @unique
  displayName         String
  givenName           String
  familyName          String
  phoneE164           String?
  staffNumber         String?    @unique
  jobTitle            String?
  passwordHash        String
  status              UserStatus @default(ACTIVE)
  statusReason        String?
  mustChangePassword  Boolean    @default(true)
  passwordChangedAt   DateTime?  @db.Timestamptz(3)
  mfaEnabled          Boolean    @default(false)
  mfaSecretEnc        String?
  mfaPendingSecretEnc String?
  failedLoginCount    Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz(3)
  lastLoginAt         DateTime?  @db.Timestamptz(3)
  defaultBranchId     String?    @db.Uuid
  isDemo              Boolean    @default(false)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  version             Int        @default(0)

  roles                   UserRole[]           @relation("UserRoleUser")
  grantedRoles            UserRole[]           @relation("UserRoleGrantedBy")
  revokedRoles            UserRole[]           @relation("UserRoleRevokedBy")
  delegatedRoles          UserRole[]           @relation("UserRoleDelegatedFrom")
  sessions                Session[]
  resetTokens             PasswordResetToken[]
  breakGlassGrants        BreakGlassGrant[]    @relation("BreakGlassUser")
  breakGlassReviews       BreakGlassGrant[]    @relation("BreakGlassReviewer")
  verifiedFacts           SetupFact[]          @relation("SetupFactVerifier")
  roleChangeRequests      RoleChangeRequest[]  @relation("RoleChangeRequester")
  roleChangeDecisions     RoleChangeRequest[]  @relation("RoleChangeDecider")
  appointmentsAsClinician Appointment[]        @relation("AppointmentClinician")
  encountersAttending     Encounter[]          @relation("EncounterAttending")
  careTeam                CareTeamAssignment[] @relation("CareTeamUser")
  notesAuthored           ClinicalNote[]       @relation("NoteAuthor")
  notesSigned             ClinicalNote[]       @relation("NoteSigner")
  vitalsRecorded          VitalSign[]          @relation("VitalRecorder")
  triageRecorded          TriageRecord[]       @relation("TriageRecorder")
  diagnosesRecorded       Diagnosis[]          @relation("DiagnosisRecorder")
  ordersPlaced            ServiceOrder[]       @relation("OrderPlacer")
  ordersReviewed          ServiceOrder[]       @relation("OrderReviewer")
  resultsEntered          LabResult[]          @relation("ResultEnterer")
  resultsVerified         LabResult[]          @relation("ResultVerifier")
  imagingReportsAuthored  ImagingReport[]      @relation("ImagingAuthor")
  imagingReportsSigned    ImagingReport[]      @relation("ImagingSigner")
  documentsUploaded       Document[]           @relation("DocumentUploader")
  prescriptionsWritten    Prescription[]       @relation("Prescriber")
  dispensesMade           DispenseEvent[]      @relation("Dispenser")
  stockMovements          StockMovement[]      @relation("StockMover")
}

enum PermissionSensitivity {
  LOW
  ADMIN
  PHI
  CLINICAL
  FINANCIAL
  HR
}

model Permission {
  code        String                @id
  resource    String
  action      String
  description String
  sensitivity PermissionSensitivity

  roles RolePermission[]
}

model Role {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  description      String?
  kind             UserKind @default(STAFF)
  isSystemTemplate Boolean  @default(false)
  requiresMfa      Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  version          Int      @default(0)

  permissions    RolePermission[]
  userRoles      UserRole[]
  changeRequests RoleChangeRequest[]
}

model RolePermission {
  roleId         String   @db.Uuid
  permissionCode String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Role permission edits require a second authorised person to approve (segregation of duties).
model RoleChangeRequest {
  id                String              @id @default(uuid()) @db.Uuid
  roleId            String              @db.Uuid
  addPermissions    String[]
  removePermissions String[]
  reason            String
  status            ChangeRequestStatus @default(PENDING)
  requestedById     String              @db.Uuid
  requestedAt       DateTime            @default(now()) @db.Timestamptz(3)
  decidedById       String?             @db.Uuid
  decidedAt         DateTime?           @db.Timestamptz(3)
  decisionNotes     String?
  roleVersion       Int

  role        Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  requestedBy User  @relation("RoleChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("RoleChangeDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status])
}

/// A role granted to a user, scoped to one branch (or all branches) and optionally a department.
/// Never deleted: revocation sets revokedAt so history is preserved.
model UserRole {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  roleId              String    @db.Uuid
  branchId            String?   @db.Uuid
  allBranches         Boolean   @default(false)
  departmentId        String?   @db.Uuid
  effectiveFrom       DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo         DateTime? @db.Timestamptz(3)
  isDelegation        Boolean   @default(false)
  delegatedFromUserId String?   @db.Uuid
  reason              String?
  grantedById         String?   @db.Uuid
  grantedAt           DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt           DateTime? @db.Timestamptz(3)
  revokedById         String?   @db.Uuid
  revokedReason       String?

  user          User        @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  role          Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch        Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  grantedBy     User?       @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy     User?       @relation("UserRoleRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  delegatedFrom User?       @relation("UserRoleDelegatedFrom", fields: [delegatedFromUserId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique
  userId         String    @db.Uuid
  activeBranchId String?   @db.Uuid
  mfaVerified    Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  ip             String?
  userAgent      String?
  revokedAt      DateTime? @db.Timestamptz(3)
  revokedReason  String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  ip         String?
  success    Boolean
  reason     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
}

enum BreakGlassReview {
  PENDING
  APPROPRIATE
  CONCERN
}

/// Time-limited emergency access to one patient's clinical record. Always reviewed by compliance.
model BreakGlassGrant {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  patientId     String           @db.Uuid
  reason        String
  justification String
  startedAt     DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime         @db.Timestamptz(3)
  endedAt       DateTime?        @db.Timestamptz(3)
  reviewStatus  BreakGlassReview @default(PENDING)
  reviewedById  String?          @db.Uuid
  reviewedAt    DateTime?        @db.Timestamptz(3)
  reviewNotes   String?

  user       User    @relation("BreakGlassUser", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?   @relation("BreakGlassReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([userId, patientId, expiresAt])
  @@index([reviewStatus])
}

enum ActorType {
  USER
  SYSTEM
  PATIENT
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Append-only, hash-chained audit trail. `details` must never contain PHI values or secrets.
/// UPDATE/DELETE are blocked by a database trigger (see migration).
model AuditEvent {
  seq          BigInt       @id @default(autoincrement())
  id           String       @unique @default(uuid()) @db.Uuid
  occurredAt   DateTime     @default(now()) @db.Timestamptz(3)
  actorType    ActorType
  actorUserId  String?      @db.Uuid
  action       String
  resourceType String
  resourceId   String?
  patientId    String?      @db.Uuid
  branchId     String?      @db.Uuid
  outcome      AuditOutcome
  requestId    String?
  ip           String?
  userAgent    String?
  details      Json?
  prevHash     String
  hash         String       @unique

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([patientId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([action])
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED_NO_PROVIDER
  SKIPPED_NO_CONSENT
}

/// Outbound messages. Payload holds template variables only - never diagnoses, results or pregnancy details.
model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  channel   NotificationChannel
  template  String
  recipient String
  userId    String?             @db.Uuid
  patientId String?             @db.Uuid
  payload   Json
  status    NotificationStatus  @default(QUEUED)
  attempts  Int                 @default(0)
  lastError String?
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  sentAt    DateTime?           @db.Timestamptz(3)
  readAt    DateTime?           @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([userId, readAt])
}

// ───────────────────────── Patient master registry ─────────────────────────

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
  MERGED
}

enum RegistrationStatus {
  COMPLETE
  PROVISIONAL
}

enum SexAtBirth {
  FEMALE
  MALE
  INTERSEX
  UNKNOWN
}

enum DobProvenance {
  DOCUMENT
  STATED
  ESTIMATED
  UNKNOWN
}

enum AllergyReviewStatus {
  NOT_ASKED
  NO_KNOWN_ALLERGIES
  HAS_ALLERGIES
}

model Patient {
  id                  String              @id @default(uuid()) @db.Uuid
  mrn                 String              @unique
  registeredBranchId  String              @db.Uuid
  givenName           String
  middleName          String?
  familyName          String
  preferredName       String?
  /// lower-cased "given middle family preferred" for search
  nameSearch          String
  dateOfBirth         DateTime?           @db.Date
  dobProvenance       DobProvenance       @default(UNKNOWN)
  sexAtBirth          SexAtBirth          @default(UNKNOWN)
  genderIdentity      String?
  phoneE164           String?
  altPhoneE164        String?
  email               String?
  addressLine         String?
  city                String?
  lga                 String?
  state               String?
  country             String              @default("NG")
  occupation          String?
  maritalStatus       String?
  preferredLanguage   String?
  referralSource      String?
  allergyReviewStatus AllergyReviewStatus @default(NOT_ASKED)
  status              PatientStatus       @default(ACTIVE)
  statusReason        String?
  registrationStatus  RegistrationStatus  @default(COMPLETE)
  deceasedAt          DateTime?           @db.Timestamptz(3)
  mergedIntoId        String?             @db.Uuid
  isDemo              Boolean             @default(false)
  createdById         String?             @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  version             Int                 @default(0)

  registeredBranch Branch                   @relation(fields: [registeredBranchId], references: [id], onDelete: Restrict)
  mergedInto       Patient?                 @relation("PatientMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom       Patient[]                @relation("PatientMerge")
  identifiers      PatientIdentifier[]
  contacts         PatientContact[]
  allergies        PatientAllergy[]
  consents         ConsentRecord[]
  guardians        GuardianRelationship[]   @relation("GuardianDependent")
  dependents       GuardianRelationship[]   @relation("GuardianPatient")
  appointments     Appointment[]
  encounters       Encounter[]
  breakGlassGrants BreakGlassGrant[]
  duplicateAsA     DuplicatePatientReview[] @relation("DupA")
  duplicateAsB     DuplicatePatientReview[] @relation("DupB")
  careTeam         CareTeamAssignment[]
  clinicalNotes    ClinicalNote[]
  vitalSigns       VitalSign[]
  triageRecords    TriageRecord[]
  diagnoses        Diagnosis[]
  orders           ServiceOrder[]
  criticalAlerts   CriticalResultAlert[]
  documents        Document[]
  prescriptions    Prescription[]

  @@index([familyName])
  @@index([phoneE164])
  @@index([dateOfBirth])
  @@index([status])
}

enum IdentifierType {
  NIN
  NHIA_NUMBER
  PASSPORT
  VOTERS_CARD
  DRIVERS_LICENCE
  OTHER
}

/// Identity documents. Value is encrypted at rest; `blindIndex` (HMAC) supports exact-match lookup.
model PatientIdentifier {
  id          String         @id @default(uuid()) @db.Uuid
  patientId   String         @db.Uuid
  type        IdentifierType
  valueEnc    String
  valueLast4  String
  blindIndex  String
  issuer      String?
  verified    Boolean        @default(false)
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  revokedAt   DateTime?      @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([type, blindIndex])
  @@index([patientId])
}

enum ContactKind {
  NEXT_OF_KIN
  EMERGENCY
  BOTH
}

model PatientContact {
  id           String      @id @default(uuid()) @db.Uuid
  patientId    String      @db.Uuid
  kind         ContactKind
  name         String
  relationship String
  phoneE164    String?
  addressLine  String?
  isPrimary    Boolean     @default(false)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
}

enum AllergyCategory {
  DRUG
  FOOD
  ENVIRONMENT
  OTHER
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

enum AllergySource {
  PATIENT_REPORTED
  CLINICIAN_VERIFIED
  PRIOR_RECORDS
}

enum AllergyStatus {
  ACTIVE
  INACTIVE
  ENTERED_IN_ERROR
}

model PatientAllergy {
  id           String          @id @default(uuid()) @db.Uuid
  patientId    String          @db.Uuid
  substance    String
  category     AllergyCategory
  reaction     String?
  severity     AllergySeverity @default(UNKNOWN)
  source       AllergySource
  status       AllergyStatus   @default(ACTIVE)
  statusReason String?
  recordedById String          @db.Uuid
  recordedAt   DateTime        @default(now()) @db.Timestamptz(3)
  verifiedById String?         @db.Uuid
  verifiedAt   DateTime?       @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
}

enum ConsentType {
  DATA_PROCESSING_NOTICE
  GENERAL_TREATMENT
  PHOTO_CAPTURE
  SMS_REMINDERS
  EMAIL_NOTICES
  WHATSAPP_MESSAGES
  PORTAL_ACCESS
}

enum ConsentStatus {
  GRANTED
  DECLINED
  WITHDRAWN
}

enum LegalBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  VITAL_INTEREST
  PUBLIC_INTEREST
  LEGITIMATE_INTEREST
}

model ConsentRecord {
  id                    String        @id @default(uuid()) @db.Uuid
  patientId             String        @db.Uuid
  type                  ConsentType
  status                ConsentStatus
  legalBasis            LegalBasis
  noticeVersion         String?
  signatoryName         String?
  signatoryRelationship String?
  notes                 String?
  capturedById          String        @db.Uuid
  capturedAt            DateTime      @default(now()) @db.Timestamptz(3)
  supersededAt          DateTime?     @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, type])
}

model GuardianRelationship {
  id                   String    @id @default(uuid()) @db.Uuid
  dependentPatientId   String    @db.Uuid
  guardianPatientId    String?   @db.Uuid
  guardianName         String
  guardianPhoneE164    String?
  relationship         String
  verified             Boolean   @default(false)
  verificationEvidence String?
  verifiedById         String?   @db.Uuid
  verifiedAt           DateTime? @db.Timestamptz(3)
  validFrom            DateTime  @default(now()) @db.Timestamptz(3)
  validTo              DateTime? @db.Timestamptz(3)
  revokedAt            DateTime? @db.Timestamptz(3)
  revokedReason        String?
  createdById          String    @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  dependent Patient  @relation("GuardianDependent", fields: [dependentPatientId], references: [id], onDelete: Restrict)
  guardian  Patient? @relation("GuardianPatient", fields: [guardianPatientId], references: [id], onDelete: Restrict)

  @@index([dependentPatientId])
  @@index([guardianPatientId])
}

enum DuplicateReviewStatus {
  OPEN
  NOT_DUPLICATE
  MERGE_REQUESTED
  MERGED
}

/// Suspected duplicate pair. patientAId < patientBId (enforced in service) so a pair appears once.
/// Merging is a two-person workflow: requested by one authorised user, approved by another.
model DuplicatePatientReview {
  id                 String                @id @default(uuid()) @db.Uuid
  patientAId         String                @db.Uuid
  patientBId         String                @db.Uuid
  score              Int
  reasons            String[]
  status             DuplicateReviewStatus @default(OPEN)
  survivorId         String?               @db.Uuid
  raisedById         String?               @db.Uuid
  raisedAt           DateTime              @default(now()) @db.Timestamptz(3)
  mergeRequestedById String?               @db.Uuid
  mergeRequestedAt   DateTime?             @db.Timestamptz(3)
  decidedById        String?               @db.Uuid
  decidedAt          DateTime?             @db.Timestamptz(3)
  decisionNotes      String?
  mergeSummary       Json?

  patientA Patient @relation("DupA", fields: [patientAId], references: [id], onDelete: Restrict)
  patientB Patient @relation("DupB", fields: [patientBId], references: [id], onDelete: Restrict)

  @@unique([patientAId, patientBId])
  @@index([status])
}

// ───────────────────────── Scheduling, check-in & queue ─────────────────────────

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentSource {
  WALK_IN
  PHONE
  ONLINE_REQUEST
  REFERRAL
  FOLLOW_UP
}

/// Double-booking of a clinician is blocked by a Postgres exclusion constraint (see migration)
/// unless `allowOverlap` is set through an authorised, audited override.
model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  ref               String            @unique
  patientId         String            @db.Uuid
  branchId          String            @db.Uuid
  departmentId      String?           @db.Uuid
  clinicianId       String?           @db.Uuid
  visitTypeId       String            @db.Uuid
  startAt           DateTime          @db.Timestamptz(3)
  endAt             DateTime          @db.Timestamptz(3)
  status            AppointmentStatus @default(BOOKED)
  source            AppointmentSource
  reason            String?
  allowOverlap      Boolean           @default(false)
  overrideReason    String?
  overrideById      String?           @db.Uuid
  cancelReason      String?
  rescheduledFromId String?           @unique @db.Uuid
  createdById       String            @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  version           Int               @default(0)

  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  branch          Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  clinician       User?        @relation("AppointmentClinician", fields: [clinicianId], references: [id], onDelete: Restrict)
  visitType       VisitType    @relation(fields: [visitTypeId], references: [id], onDelete: Restrict)
  rescheduledFrom Appointment? @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  rescheduledTo   Appointment? @relation("Reschedule")
  encounter       Encounter?

  @@index([branchId, startAt])
  @@index([clinicianId, startAt])
  @@index([patientId, startAt])
  @@index([status])
}

enum PayerClass {
  UNDETERMINED
  CASH
  HMO
  CORPORATE
  PART_INSURED
}

enum QueueStage {
  REGISTERED
  AWAITING_VITALS
  READY_FOR_DOCTOR
  IN_CONSULTATION
  AWAITING_SERVICES
  AWAITING_REVIEW
  READY_TO_DISCHARGE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum EncounterStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum EncounterPriority {
  ROUTINE
  URGENT
  EMERGENCY
}

model Encounter {
  id                         String            @id @default(uuid()) @db.Uuid
  ref                        String            @unique
  patientId                  String            @db.Uuid
  branchId                   String            @db.Uuid
  departmentId               String?           @db.Uuid
  appointmentId              String?           @unique @db.Uuid
  visitTypeId                String            @db.Uuid
  attendingClinicianId       String?           @db.Uuid
  payerClass                 PayerClass        @default(UNDETERMINED)
  priority                   EncounterPriority @default(ROUTINE)
  queueStage                 QueueStage        @default(REGISTERED)
  status                     EncounterStatus   @default(OPEN)
  reason                     String?
  referralSource             String?
  financialTermsAcknowledged Boolean           @default(false)
  arrivedAt                  DateTime          @default(now()) @db.Timestamptz(3)
  completedAt                DateTime?         @db.Timestamptz(3)
  createdById                String            @db.Uuid
  createdAt                  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @db.Timestamptz(3)
  version                    Int               @default(0)

  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department    Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  visitType     VisitType            @relation(fields: [visitTypeId], references: [id], onDelete: Restrict)
  attending     User?                @relation("EncounterAttending", fields: [attendingClinicianId], references: [id], onDelete: Restrict)
  queueEvents   VisitQueueEvent[]
  careTeam      CareTeamAssignment[]
  notes         ClinicalNote[]
  vitals        VitalSign[]
  triage        TriageRecord[]
  diagnoses     Diagnosis[]
  orders        ServiceOrder[]
  documents     Document[]
  prescriptions Prescription[]

  @@index([branchId, arrivedAt])
  @@index([branchId, status, queueStage])
  @@index([patientId, arrivedAt])
}

/// Append-only history of every queue-stage change.
model VisitQueueEvent {
  id          String      @id @default(uuid()) @db.Uuid
  encounterId String      @db.Uuid
  fromStage   QueueStage?
  toStage     QueueStage
  note        String?
  changedById String      @db.Uuid
  changedAt   DateTime    @default(now()) @db.Timestamptz(3)

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)

  @@index([encounterId, changedAt])
}

enum CareTeamRole {
  ATTENDING
  CONSULTING
  NURSE
  MIDWIFE
}

/// Establishes the care relationship that grants record-level clinical access.
model CareTeamAssignment {
  id           String       @id @default(uuid()) @db.Uuid
  encounterId  String       @db.Uuid
  patientId    String       @db.Uuid
  userId       String       @db.Uuid
  role         CareTeamRole
  assignedById String       @db.Uuid
  assignedAt   DateTime     @default(now()) @db.Timestamptz(3)
  endedAt      DateTime?    @db.Timestamptz(3)

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  user      User      @relation("CareTeamUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, patientId])
  @@index([encounterId])
}

// ───────────────────────── Phase 2: clinical documentation ─────────────────────────

enum ClinicalNoteType {
  CONSULTATION
  PROGRESS
  NURSING
  PROCEDURE
  ADDENDUM
}

enum NoteStatus {
  DRAFT
  SIGNED
  DISCARDED
}

/// SOAP-structured clinical note. Drafts are versioned on every save; once SIGNED the row is
/// immutable (DB trigger). Corrections are separate ADDENDUM notes pointing at the original.
model ClinicalNote {
  id           String           @id @default(uuid()) @db.Uuid
  encounterId  String           @db.Uuid
  patientId    String           @db.Uuid
  type         ClinicalNoteType
  status       NoteStatus       @default(DRAFT)
  templateKey  String?
  content      Json
  version      Int              @default(1)
  authorId     String           @db.Uuid
  parentNoteId String?          @db.Uuid
  signedById   String?          @db.Uuid
  signedAt     DateTime?        @db.Timestamptz(3)
  contentHash  String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  encounter Encounter             @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient   Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  author    User                  @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  signedBy  User?                 @relation("NoteSigner", fields: [signedById], references: [id], onDelete: Restrict)
  parent    ClinicalNote?         @relation("NoteAddenda", fields: [parentNoteId], references: [id], onDelete: Restrict)
  addenda   ClinicalNote[]        @relation("NoteAddenda")
  versions  ClinicalNoteVersion[]

  @@index([patientId, createdAt])
  @@index([encounterId])
  @@index([authorId, status])
}

/// Every saved draft state. Append-only.
model ClinicalNoteVersion {
  id        String   @id @default(uuid()) @db.Uuid
  noteId    String   @db.Uuid
  version   Int
  content   Json
  savedById String   @db.Uuid
  savedAt   DateTime @default(now()) @db.Timestamptz(3)

  note ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@unique([noteId, version])
}

model TriageRecord {
  id                 String    @id @default(uuid()) @db.Uuid
  encounterId        String    @db.Uuid
  patientId          String    @db.Uuid
  chiefComplaint     String
  acuity             String
  notes              String?
  recordedById       String    @db.Uuid
  recordedAt         DateTime  @default(now()) @db.Timestamptz(3)
  enteredInErrorAt   DateTime? @db.Timestamptz(3)
  enteredInErrorById String?   @db.Uuid
  errorReason        String?

  encounter  Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy User      @relation("TriageRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([encounterId])
}

enum VitalContext {
  OUTPATIENT
  INPATIENT
  ANTENATAL
}

/// One observation set. Units are part of the column names. Plausibility CHECKs are data-entry
/// guards only - clinical thresholds live in VitalThreshold and require clinician approval.
model VitalSign {
  id                 String       @id @default(uuid()) @db.Uuid
  encounterId        String?      @db.Uuid
  patientId          String       @db.Uuid
  context            VitalContext @default(OUTPATIENT)
  measuredAt         DateTime     @db.Timestamptz(3)
  recordedAt         DateTime     @default(now()) @db.Timestamptz(3)
  recordedById       String       @db.Uuid
  temperatureC       Decimal?     @db.Decimal(4, 1)
  pulseBpm           Int?
  respRatePerMin     Int?
  systolicMmHg       Int?
  diastolicMmHg      Int?
  spo2Pct            Int?
  weightKg           Decimal?     @db.Decimal(5, 2)
  heightCm           Decimal?     @db.Decimal(5, 1)
  painScore          Int?
  notes              String?
  enteredInErrorAt   DateTime?    @db.Timestamptz(3)
  enteredInErrorById String?      @db.Uuid
  errorReason        String?

  encounter  Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy User       @relation("VitalRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([patientId, measuredAt])
  @@index([encounterId])
}

enum VitalParameter {
  TEMPERATURE_C
  PULSE_BPM
  RESP_RATE
  SYSTOLIC
  DIASTOLIC
  SPO2
}

enum ClinicalRuleStatus {
  DRAFT
  APPROVED
  RETIRED
}

/// Adult display thresholds. Only APPROVED rows (with a named approving clinician) produce flags.
model VitalThreshold {
  id           String             @id @default(uuid()) @db.Uuid
  parameter    VitalParameter
  low          Decimal?           @db.Decimal(6, 1)
  high         Decimal?           @db.Decimal(6, 1)
  criticalLow  Decimal?           @db.Decimal(6, 1)
  criticalHigh Decimal?           @db.Decimal(6, 1)
  status       ClinicalRuleStatus @default(DRAFT)
  source       String?
  createdById  String?            @db.Uuid
  approvedById String?            @db.Uuid
  approvedAt   DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  @@index([parameter, status])
}

enum DiagnosisCertainty {
  PROVISIONAL
  CONFIRMED
  REFUTED
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  ENTERED_IN_ERROR
}

model Diagnosis {
  id            String             @id @default(uuid()) @db.Uuid
  encounterId   String             @db.Uuid
  patientId     String             @db.Uuid
  description   String
  code          String?
  codeSystem    String?
  certainty     DiagnosisCertainty
  status        DiagnosisStatus    @default(ACTIVE)
  statusReason  String?
  isPrimary     Boolean            @default(false)
  onProblemList Boolean            @default(false)
  recordedById  String             @db.Uuid
  recordedAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  version       Int                @default(0)

  encounter  Encounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  recordedBy User      @relation("DiagnosisRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([patientId, status])
  @@index([encounterId])
}

// ───────────────────────── Phase 2: orders, laboratory, imaging ─────────────────────────

enum LabResultType {
  NUMERIC
  TEXT
  CODED
}

model LabTestDefinition {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  specimenType    String
  turnaroundHours Int?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  components LabTestComponent[]
  orders     ServiceOrder[]
}

model LabTestComponent {
  id            String        @id @default(uuid()) @db.Uuid
  testId        String        @db.Uuid
  code          String
  name          String
  unit          String?
  resultType    LabResultType
  decimals      Int?
  allowedValues String[]
  sortOrder     Int           @default(0)

  test    LabTestDefinition   @relation(fields: [testId], references: [id], onDelete: Restrict)
  ranges  LabReferenceRange[]
  results LabResult[]

  @@unique([testId, code])
}

enum RangeSex {
  ANY
  FEMALE
  MALE
}

/// Reference ranges are clinical content: only APPROVED rows (named approver) generate flags.
model LabReferenceRange {
  id           String             @id @default(uuid()) @db.Uuid
  componentId  String             @db.Uuid
  sex          RangeSex           @default(ANY)
  ageMinDays   Int                @default(0)
  ageMaxDays   Int?
  low          Decimal?           @db.Decimal(12, 4)
  high         Decimal?           @db.Decimal(12, 4)
  criticalLow  Decimal?           @db.Decimal(12, 4)
  criticalHigh Decimal?           @db.Decimal(12, 4)
  normalText   String?
  status       ClinicalRuleStatus @default(DRAFT)
  source       String?
  createdById  String?            @db.Uuid
  approvedById String?            @db.Uuid
  approvedAt   DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  component LabTestComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([componentId, status])
}

enum ImagingModality {
  XRAY
  ULTRASOUND
  CT
  MRI
  ECG
  OTHER
}

model ImagingStudyDefinition {
  id        String          @id @default(uuid()) @db.Uuid
  code      String          @unique
  name      String
  modality  ImagingModality
  bodyPart  String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  orders ServiceOrder[]
}

enum OrderKind {
  LAB
  IMAGING
  PROCEDURE
  REFERRAL
}

enum OrderPriority {
  ROUTINE
  URGENT
  STAT
}

enum OrderStatus {
  ORDERED
  SCHEDULED
  SPECIMEN_COLLECTED
  IN_PROGRESS
  RESULTED
  VERIFIED
  COMPLETED
  CANCELLED
}

/// One orderable item (a single test or study). Items ordered together share requestGroupId,
/// which doubles as the idempotency key: (requestGroupId, itemIndex) is unique.
model ServiceOrder {
  id                 String        @id @default(uuid()) @db.Uuid
  ref                String        @unique
  requestGroupId     String        @db.Uuid
  itemIndex          Int
  kind               OrderKind
  encounterId        String        @db.Uuid
  patientId          String        @db.Uuid
  branchId           String        @db.Uuid
  labTestId          String?       @db.Uuid
  imagingStudyId     String?       @db.Uuid
  description        String
  priority           OrderPriority @default(ROUTINE)
  clinicalIndication String?
  notes              String?
  status             OrderStatus   @default(ORDERED)
  orderedById        String        @db.Uuid
  orderedAt          DateTime      @default(now()) @db.Timestamptz(3)
  scheduledAt        DateTime?     @db.Timestamptz(3)
  resultedAt         DateTime?     @db.Timestamptz(3)
  verifiedAt         DateTime?     @db.Timestamptz(3)
  completedAt        DateTime?     @db.Timestamptz(3)
  cancelledAt        DateTime?     @db.Timestamptz(3)
  cancelledById      String?       @db.Uuid
  cancelReason       String?
  reviewedAt         DateTime?     @db.Timestamptz(3)
  reviewedById       String?       @db.Uuid
  version            Int           @default(0)

  encounter      Encounter               @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient        Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  branch         Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  labTest        LabTestDefinition?      @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  imagingStudy   ImagingStudyDefinition? @relation(fields: [imagingStudyId], references: [id], onDelete: Restrict)
  orderedBy      User                    @relation("OrderPlacer", fields: [orderedById], references: [id], onDelete: Restrict)
  reviewedBy     User?                   @relation("OrderReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  events         OrderStatusEvent[]
  specimens      LabSpecimen[]
  results        LabResult[]
  criticalAlerts CriticalResultAlert[]
  imagingReports ImagingReport[]
  documents      Document[]

  @@unique([requestGroupId, itemIndex])
  @@index([branchId, kind, status])
  @@index([patientId, orderedAt])
  @@index([encounterId])
}

model OrderStatusEvent {
  id          String       @id @default(uuid()) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String       @db.Uuid
  changedAt   DateTime     @default(now()) @db.Timestamptz(3)

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, changedAt])
}

enum SpecimenStatus {
  COLLECTED
  RECEIVED
  REJECTED
}

model LabSpecimen {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @db.Uuid
  accession       String         @unique
  specimenType    String
  status          SpecimenStatus @default(COLLECTED)
  collectedAt     DateTime       @db.Timestamptz(3)
  collectedById   String         @db.Uuid
  receivedAt      DateTime?      @db.Timestamptz(3)
  receivedById    String?        @db.Uuid
  rejectedAt      DateTime?      @db.Timestamptz(3)
  rejectedById    String?        @db.Uuid
  rejectionReason String?

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

enum ResultFlag {
  NONE
  NORMAL
  LOW
  HIGH
  CRITICAL_LOW
  CRITICAL_HIGH
  ABNORMAL
}

enum ResultStatus {
  DRAFT
  FINAL
}

/// DRAFT results may be edited until verification. FINAL rows are immutable (DB trigger) except for
/// being marked superseded by an accountable amendment, which is a new FINAL row (amendsResultId).
model LabResult {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  componentId     String       @db.Uuid
  valueText       String
  valueNumeric    Decimal?     @db.Decimal(14, 4)
  unit            String?
  referenceText   String?
  flag            ResultFlag   @default(NONE)
  status          ResultStatus @default(DRAFT)
  enteredById     String       @db.Uuid
  enteredAt       DateTime     @default(now()) @db.Timestamptz(3)
  verifiedById    String?      @db.Uuid
  verifiedAt      DateTime?    @db.Timestamptz(3)
  amendsResultId  String?      @unique @db.Uuid
  amendmentReason String?
  supersededAt    DateTime?    @db.Timestamptz(3)
  supersededById  String?      @db.Uuid

  order      ServiceOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  component  LabTestComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  enteredBy  User             @relation("ResultEnterer", fields: [enteredById], references: [id], onDelete: Restrict)
  verifiedBy User?            @relation("ResultVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  amends     LabResult?       @relation("ResultAmendment", fields: [amendsResultId], references: [id], onDelete: Restrict)
  amendedBy  LabResult?       @relation("ResultAmendment")

  @@index([orderId])
}

/// Raised when a verified result carries a critical flag; must be acknowledged by an accountable person.
model CriticalResultAlert {
  id                  String    @id @default(uuid()) @db.Uuid
  orderId             String    @db.Uuid
  patientId           String    @db.Uuid
  raisedAt            DateTime  @default(now()) @db.Timestamptz(3)
  summary             String
  acknowledgedById    String?   @db.Uuid
  acknowledgedAt      DateTime? @db.Timestamptz(3)
  communicatedTo      String?
  communicationMethod String?
  notes               String?

  order   ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  patient Patient      @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([acknowledgedAt])
}

enum ReportStatus {
  DRAFT
  SIGNED
}

model ImagingReport {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  findings        String
  impression      String
  status          ReportStatus @default(DRAFT)
  authorId        String       @db.Uuid
  signedById      String?      @db.Uuid
  signedAt        DateTime?    @db.Timestamptz(3)
  contentHash     String?
  amendsReportId  String?      @unique @db.Uuid
  amendmentReason String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  order     ServiceOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  author    User           @relation("ImagingAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  signedBy  User?          @relation("ImagingSigner", fields: [signedById], references: [id], onDelete: Restrict)
  amends    ImagingReport? @relation("ReportAmendment", fields: [amendsReportId], references: [id], onDelete: Restrict)
  amendedBy ImagingReport? @relation("ReportAmendment")

  @@index([orderId])
}

// ───────────────────────── Phase 2: documents ─────────────────────────

enum DocumentKind {
  LAB_REPORT
  IMAGING
  REFERRAL
  CONSENT
  CLINICAL_OTHER
  ADMINISTRATIVE
}

enum DocumentSource {
  INTERNAL
  EXTERNAL
}

enum ScanStatus {
  NOT_SCANNED
  CLEAN
  INFECTED
}

/// Stored files. Bytes live in object storage under an unguessable key; downloads always go through
/// an authorised, audited route. Documents are voided, never deleted.
model Document {
  id                String         @id @default(uuid()) @db.Uuid
  patientId         String?        @db.Uuid
  encounterId       String?        @db.Uuid
  orderId           String?        @db.Uuid
  kind              DocumentKind
  title             String
  filename          String
  mimeType          String
  sizeBytes         Int
  sha256            String
  storageKey        String         @unique
  source            DocumentSource @default(INTERNAL)
  sourceDescription String?
  scanStatus        ScanStatus     @default(NOT_SCANNED)
  uploadedById      String         @db.Uuid
  uploadedAt        DateTime       @default(now()) @db.Timestamptz(3)
  voidedAt          DateTime?      @db.Timestamptz(3)
  voidedById        String?        @db.Uuid
  voidReason        String?

  patient    Patient?      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter  Encounter?    @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  order      ServiceOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  uploadedBy User          @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([patientId, uploadedAt])
  @@index([orderId])
}

// ───────────────────────── Phase 3: inventory ─────────────────────────

enum InventoryCategory {
  PHARMACY
  LAB_CONSUMABLE
  MEDICAL_SUPPLY
  MATERNITY_THEATRE
  OFFICE_MAINTENANCE
  ASSET
}

model InventoryProduct {
  id              String            @id @default(uuid()) @db.Uuid
  sku             String            @unique
  name            String
  category        InventoryCategory
  baseUnit        String
  reorderLevel    Int               @default(0)
  reorderQuantity Int               @default(0)
  trackExpiry     Boolean           @default(true)
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  medication MedicationProduct?
  lots       InventoryLot[]
  movements  StockMovement[]
  reqItems   RequisitionItem[]
  poItems    PurchaseOrderItem[]
}

enum StockLocationKind {
  MAIN_STORE
  PHARMACY
  WARD
  LABORATORY
  THEATRE
  QUARANTINE
}

model StockLocation {
  id        String            @id @default(uuid()) @db.Uuid
  branchId  String            @db.Uuid
  code      String
  name      String
  kind      StockLocationKind
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  balances  StockBalance[]
  movements StockMovement[]
  counts    StockCount[]

  @@unique([branchId, code])
}

enum LotStatus {
  AVAILABLE
  QUARANTINED
  RECALLED
}

/// A batch of a product. Expiry is a calendar date; a lot is unusable from its expiry date onward.
model InventoryLot {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @db.Uuid
  lotNumber    String
  expiryDate   DateTime? @db.Date
  manufacturer String?
  supplierId   String?   @db.Uuid
  unitCostKobo BigInt?
  status       LotStatus @default(AVAILABLE)
  statusReason String?
  receivedAt   DateTime  @default(now()) @db.Timestamptz(3)

  product   InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplier  Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  balances  StockBalance[]
  movements StockMovement[]
  dispenses DispenseEvent[]

  @@unique([productId, lotNumber])
  @@index([expiryDate])
}

/// Current quantity of a lot at a location. Maintained in the same transaction as the ledger;
/// a CHECK constraint forbids negative stock.
model StockBalance {
  lotId      String   @db.Uuid
  locationId String   @db.Uuid
  quantity   Int
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  lot      InventoryLot  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@id([lotId, locationId])
}

enum StockMovementType {
  RECEIPT
  DISPENSE
  DISPENSE_REVERSAL
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  COUNT_ADJUSTMENT
  CONSUMPTION
}

/// Permanent stock ledger (append-only). quantity is signed; balanceAfter is the lot/location
/// balance immediately after this movement.
model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  productId      String            @db.Uuid
  lotId          String            @db.Uuid
  locationId     String            @db.Uuid
  type           StockMovementType
  quantity       Int
  balanceAfter   Int
  reason         String?
  referenceType  String?
  referenceId    String?
  idempotencyKey String?           @unique
  performedById  String            @db.Uuid
  occurredAt     DateTime          @default(now()) @db.Timestamptz(3)

  product     InventoryProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  lot         InventoryLot     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  location    StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  performedBy User             @relation("StockMover", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([lotId, locationId, occurredAt])
  @@index([productId, occurredAt])
  @@index([referenceType, referenceId])
}

enum AdjustmentReason {
  DAMAGED
  EXPIRED
  LOST
  RECALLED
  FOUND
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Stock corrections need a second person to approve before they post to the ledger.
model StockAdjustmentRequest {
  id            String           @id @default(uuid()) @db.Uuid
  lotId         String           @db.Uuid
  locationId    String           @db.Uuid
  quantityDelta Int
  reason        AdjustmentReason
  notes         String
  status        ApprovalStatus   @default(PENDING)
  requestedById String           @db.Uuid
  requestedAt   DateTime         @default(now()) @db.Timestamptz(3)
  decidedById   String?          @db.Uuid
  decidedAt     DateTime?        @db.Timestamptz(3)
  decisionNotes String?
  movementId    String?          @db.Uuid

  @@index([status])
}

enum StockCountStatus {
  OPEN
  SUBMITTED
  APPROVED
  CANCELLED
}

model StockCount {
  id            String           @id @default(uuid()) @db.Uuid
  ref           String           @unique
  locationId    String           @db.Uuid
  status        StockCountStatus @default(OPEN)
  startedById   String           @db.Uuid
  startedAt     DateTime         @default(now()) @db.Timestamptz(3)
  submittedById String?          @db.Uuid
  submittedAt   DateTime?        @db.Timestamptz(3)
  approvedById  String?          @db.Uuid
  approvedAt    DateTime?        @db.Timestamptz(3)
  notes         String?

  location StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines    StockCountLine[]
}

model StockCountLine {
  id           String  @id @default(uuid()) @db.Uuid
  countId      String  @db.Uuid
  lotId        String  @db.Uuid
  systemQty    Int
  countedQty   Int?
  varianceNote String?

  count StockCount @relation(fields: [countId], references: [id], onDelete: Restrict)

  @@unique([countId, lotId])
}

// ───────────────────────── Phase 3: procurement ─────────────────────────

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  contactName String?
  phoneE164   String?
  email       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  lots           InventoryLot[]
  purchaseOrders PurchaseOrder[]
}

enum RequisitionStatus {
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

model PurchaseRequisition {
  id            String            @id @default(uuid()) @db.Uuid
  ref           String            @unique
  branchId      String            @db.Uuid
  status        RequisitionStatus @default(SUBMITTED)
  justification String
  requestedById String            @db.Uuid
  requestedAt   DateTime          @default(now()) @db.Timestamptz(3)
  decidedById   String?           @db.Uuid
  decidedAt     DateTime?         @db.Timestamptz(3)
  decisionNotes String?

  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items          RequisitionItem[]
  purchaseOrders PurchaseOrder[]
}

model RequisitionItem {
  id            String  @id @default(uuid()) @db.Uuid
  requisitionId String  @db.Uuid
  productId     String  @db.Uuid
  quantity      Int
  note          String?

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  product     InventoryProduct    @relation(fields: [productId], references: [id], onDelete: Restrict)
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id            String              @id @default(uuid()) @db.Uuid
  ref           String              @unique
  supplierId    String              @db.Uuid
  requisitionId String?             @db.Uuid
  branchId      String              @db.Uuid
  status        PurchaseOrderStatus @default(DRAFT)
  createdById   String              @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  issuedById    String?             @db.Uuid
  issuedAt      DateTime?           @db.Timestamptz(3)
  notes         String?
  version       Int                 @default(0)

  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  requisition PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  receipts    GoodsReceipt[]
}

model PurchaseOrderItem {
  id               String @id @default(uuid()) @db.Uuid
  purchaseOrderId  String @db.Uuid
  productId        String @db.Uuid
  quantityOrdered  Int
  quantityReceived Int    @default(0)
  unitCostKobo     BigInt

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  product       InventoryProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptLines  GoodsReceiptLine[]
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  ref             String   @unique
  purchaseOrderId String   @db.Uuid
  locationId      String   @db.Uuid
  receivedById    String   @db.Uuid
  receivedAt      DateTime @default(now()) @db.Timestamptz(3)
  deliveryNote    String?
  idempotencyKey  String   @unique

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lines         GoodsReceiptLine[]
}

model GoodsReceiptLine {
  id           String  @id @default(uuid()) @db.Uuid
  receiptId    String  @db.Uuid
  poItemId     String  @db.Uuid
  lotId        String  @db.Uuid
  quantity     Int
  unitCostKobo BigInt
  quarantined  Boolean @default(false)

  receipt GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  poItem  PurchaseOrderItem @relation(fields: [poItemId], references: [id], onDelete: Restrict)
}

// ───────────────────────── Phase 3: medications & prescribing ─────────────────────────

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  SUSPENSION
  INJECTION
  INFUSION
  CREAM
  OINTMENT
  DROPS
  INHALER
  SUPPOSITORY
  PESSARY
  OTHER
}

enum FormularyStatus {
  FORMULARY
  RESTRICTED
  NON_FORMULARY
}

/// Medication master. Dispensing draws stock from the linked InventoryProduct in its base unit.
model MedicationProduct {
  id                 String          @id @default(uuid()) @db.Uuid
  inventoryProductId String          @unique @db.Uuid
  genericName        String
  brandName          String?
  strength           String
  form               DosageForm
  defaultRoute       String
  dispensingUnit     String
  nafdacNumber       String?
  nafdacVerified     Boolean         @default(false)
  controlled         Boolean         @default(false)
  formularyStatus    FormularyStatus @default(FORMULARY)
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  inventoryProduct InventoryProduct   @relation(fields: [inventoryProductId], references: [id], onDelete: Restrict)
  items            PrescriptionItem[]

  @@index([genericName])
}

/// Dose-frequency dictionary. Clinical content: usable for prescribing only when APPROVED.
model MedicationFrequency {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique
  label        String
  timesPerDay  Decimal?           @db.Decimal(5, 2)
  status       ClinicalRuleStatus @default(DRAFT)
  createdById  String?            @db.Uuid
  approvedById String?            @db.Uuid
  approvedAt   DateTime?          @db.Timestamptz(3)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)

  items PrescriptionItem[]
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  CANCELLED
  COMPLETED
}

model Prescription {
  id           String             @id @default(uuid()) @db.Uuid
  ref          String             @unique
  encounterId  String             @db.Uuid
  patientId    String             @db.Uuid
  branchId     String             @db.Uuid
  prescriberId String             @db.Uuid
  status       PrescriptionStatus @default(DRAFT)
  notes        String?
  signedAt     DateTime?          @db.Timestamptz(3)
  contentHash  String?
  cancelledAt  DateTime?          @db.Timestamptz(3)
  cancelReason String?
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  version      Int                @default(0)

  encounter  Encounter          @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patient    Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  prescriber User               @relation("Prescriber", fields: [prescriberId], references: [id], onDelete: Restrict)
  items      PrescriptionItem[]

  @@index([branchId, status])
  @@index([patientId, createdAt])
}

enum PrescriptionItemStatus {
  PENDING
  QUERIED
  VERIFIED
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

model PrescriptionItem {
  id                String                 @id @default(uuid()) @db.Uuid
  prescriptionId    String                 @db.Uuid
  medicationId      String                 @db.Uuid
  dose              String
  route             String
  frequencyId       String                 @db.Uuid
  durationDays      Int?
  prn               Boolean                @default(false)
  quantity          Int
  instructions      String?
  status            PrescriptionItemStatus @default(PENDING)
  quantityDispensed Int                    @default(0)
  verifiedById      String?                @db.Uuid
  verifiedAt        DateTime?              @db.Timestamptz(3)
  pharmacistNote    String?
  cancelledAt       DateTime?              @db.Timestamptz(3)
  cancelReason      String?
  version           Int                    @default(0)

  prescription Prescription        @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  medication   MedicationProduct   @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  frequency    MedicationFrequency @relation(fields: [frequencyId], references: [id], onDelete: Restrict)
  dispenses    DispenseEvent[]

  @@index([prescriptionId])
}

/// One issue of stock against a prescription item. idempotencyKey guarantees a retried request
/// dispenses exactly once.
model DispenseEvent {
  id               String    @id @default(uuid()) @db.Uuid
  itemId           String    @db.Uuid
  lotId            String    @db.Uuid
  locationId       String    @db.Uuid
  quantity         Int
  dispensedById    String    @db.Uuid
  dispensedAt      DateTime  @default(now()) @db.Timestamptz(3)
  counsellingGiven Boolean   @default(false)
  idempotencyKey   String
  movementId       String    @unique @db.Uuid
  reversedAt       DateTime? @db.Timestamptz(3)
  reversedById     String?   @db.Uuid
  reversalReason   String?

  item        PrescriptionItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot         InventoryLot     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  dispensedBy User             @relation("Dispenser", fields: [dispensedById], references: [id], onDelete: Restrict)

  @@unique([idempotencyKey, lotId])
  @@index([itemId])
}
