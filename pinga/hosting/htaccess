# Pinga on Hostinger (Apache). Uploaded as .htaccess by scripts/publish.js.
Options -Indexes
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # The app's code must always be fresh, or a phone (or the CDN) could mix old and new files
  # after an update. "no-cache" still allows a quick "not changed" answer, so it stays fast.
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Icons and the owner-only map library rarely change.
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # The barcode reader never changes for a given version (its folder name carries the version in sw.js).
  <FilesMatch "\.wasm$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest
AddType text/javascript .js
AddType application/wasm .wasm
